[Desktop Entry]
Version=1.0
Terminal=false
Type=Application
Name=Excalidraw
MimeType=application/vnd.excalidraw+json
Exec=/opt/brave-bin/brave --ozone-platform=wayland --enable-features=UseOzonePlatform --profile-directory=Default --app-id=dnfpoenibinnbbckgbhendmlljoobcfg %U
Icon=brave-dnfpoenibinnbbckgbhendmlljoobcfg-Default
StartupWMClass=crx_dnfpoenibinnbbckgbhendmlljoobcfg

