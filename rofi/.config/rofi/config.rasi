configuration {
    /* Display settings */
      modi: "drun,run,window,ssh,combi";
      show-icons: true;
      icon-theme: "Papirus-Dark";

      /* Behavior */
      display-drun: "󰀻 Apps";
      display-run: " Run";
      display-window: "󰖯 Windows";
      display-ssh: "󰢹 SSH";
      display-combi: "󰛡 All";

      /* Matching */
      matching: "fuzzy";
      sort: true;
      sorting-method: "fzf";
      case-sensitive: false;

                    /* Terminal for applications that need it */
    terminal: "ghostty";

    /* SSH settings */
    ssh-client: "ssh";
    ssh-command: "{terminal} -e {ssh-client} {host} [-p {port}]";

    /* Window settings */
    window-match-fields: "title,class,role,name,desktop";

    /* Combi settings */
    combi-modi: "drun,run,window";
    combi-hide-mode-prefix: false;

    /* Behavior tweaks */
    drun-display-format: "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format: "{w} {c} {t}";

    /* Performance */
    lazy-grab: false;
    plugin-path: "/usr/lib/rofi";

    /* Keybindings - Vim-like navigation */
    // kb-row-up: "Up,Control+k,Shift+Tab,Shift+ISO_Left_Tab";
    // kb-row-down: "Down,Control+j,Tab";
    // kb-row-left: "Control+Page_Up,Control+h";
    // kb-row-right: "Control+Page_Down,Control+l";
    // kb-row-first: "Home,Control+g";
    // kb-row-last: "End,Control+G";
    // kb-row-select: "Control+space";
    // kb-screenshot: "Alt+Shift+s";
    // kb-ellipsize: "Alt+period";

    /* Advanced options */
    timeout {
        action: "kb-cancel";
        delay: 0;
    }

    /* File browser settings */
    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }

    /* Icon settings */
    application-fallback-icon: "application-x-executable";

    /* Disable history for certain modes */
    disable-history: false;

    /* Maximum number of lines to show */
    lines: 8;

    /* Fixed number of columns */
    columns: 1;

    /* Font override (if needed) */
    font: "JetBrains Mono Nerd Font 14";

    /* DPI settings */
    dpi: -1;
}



// @theme "~/.config/rofi/themes/sweet-dreams.rasi"
@theme "~/.config/rofi/themes/unixporn.rasi"
